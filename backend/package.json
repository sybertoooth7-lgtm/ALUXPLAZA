{
  "name": "alux-plaza-backend",
  "version": "2.0.0",
  "description": "Production backend: PostgreSQL, JWT auth, email notifications, rate limiting.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "create-admin": "node src/scripts/create-admin.js",
    "migrate": "node src/migrate.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:nodb": "vitest run --config vitest.nodb.config.js"
  },
  "dependencies": {
    "@sentry/node": "^10.66.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1",
    "pg-boss": "^12.36.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
