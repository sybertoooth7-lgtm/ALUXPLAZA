# ============================================================================
# Backend environment variables — every var below is actually read via
# process.env somewhere in backend/src (verified against the code, not
# guessed). Copy to backend/.env for local dev; set the same names as
# Railway service variables for deployment.
#
# CI CONTRACT: .github/workflows/ci.yml and backend-ci.yml both do
# `cp .env.example .env` from inside backend/, then sed-replace NODE_ENV
# and the JWT_SECRET placeholder. DATABASE_URL below matches their
# postgres service container (alux:password@localhost:5432/alux_plaza).
# ============================================================================

# --- Core / Auth -------------------------------------------------------------
# Runtime mode. 'production' enables Secure cookies, forced DB SSL, strict
# CORS checks, and exit-on-stale-admin-bootstrap. (required)
NODE_ENV=development
# HTTP port the server listens on. config.js defaults to 3001 if unset —
# set explicitly so it matches whatever you're proxying/curling.
# (optional, default: 3001)
PORT=3001
# JWT signing secret. REQUIRED in EVERY environment — config.js throws at
# boot if missing (no dev fallback exists). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-64-char-random-secret-here-change-me
# Access-token lifetime passed to jsonwebtoken. (optional, default: 2h)
JWT_EXPIRES_IN=2h
# Cookie-signing secret; falls back to JWT_SECRET when unset.
# (optional, >= 32 chars recommended)
COOKIE_SECRET=

# --- Database ------------------------------------------------------------
# PostgreSQL connection string. (required)
DATABASE_URL=postgresql://alux:password@localhost:5432/alux_plaza
# Set to 'false' to disable SSL. Production defaults to SSL enabled;
# setting this false in production logs a boot warning. (optional)
DB_SSL=false
# Set to 'false' to skip TLS certificate verification (self-signed certs
# on some managed Postgres providers). (optional, default: verify)
DB_SSL_VERIFY=

# --- CORS ------------------------------------------------------------------
# Comma-separated allowlist of browser origins (trailing slashes stripped
# automatically). Required in production — CORS stays disabled with a
# boot warning if left empty.
CORS_ORIGIN=https://yourdomain.com

# --- Frontend URL ------------------------------------------------------------
# Used to build links in emails (verification, password reset). Must match
# the deployed frontend origin, no trailing slash.
FRONTEND_URL=https://yourdomain.com

# --- Email (Resend) — all optional; email is silently skipped if unset -----
# API key for Resend; contact-form notifications are skipped without it.
RESEND_API_KEY=re_xxxxxxxx
# Verified sender address shown to recipients.
FROM_EMAIL=onboarding@resend.dev
# Inbox that receives contact-form notifications.
ADMIN_EMAIL=you@example.com

# --- Monitoring — all optional ----------------------------------------------
# Sentry DSN; error tracking is enabled only when set.
SENTRY_DSN=
# Webhook URL that receives operational/security alert POSTs (e.g. Discord).
ALERT_WEBHOOK_URL=
# Pino log level: trace | debug | info | warn | error | fatal.
# (optional, default: info)
LOG_LEVEL=info

# --- Rate limiting (contact endpoint) — both optional -----------------------
# Sliding window length for contact submissions, in minutes. (default: 15)
CONTACT_RATE_LIMIT_WINDOW_MINUTES=15
# Max requests allowed per IP within the window. (default: 5)
CONTACT_RATE_LIMIT_MAX=5

# --- Data retention ----------------------------------------------------------
# Controls the daily retention job (src/jobs/retention.js), which deletes data
# older than the periods in the Privacy Policy: contact messages after 12
# months, closed client accounts after 24 months, audit-log entries after 24
# months. 'dry-run' (the default when unset) only logs what WOULD be deleted;
# 'enforce' deletes; 'off' skips the job. Read the dry-run log lines for a few
# days before switching to 'enforce': deletion cannot be undone.
# (optional, default: dry-run)
# RETENTION_MODE=dry-run

# --- Admin bootstrap (one-time setup) ---------------------------------------
# Credentials for an idempotent first superadmin, created at boot
# (INSERT ... ON CONFLICT DO NOTHING — safe to leave set across restarts
# until an admin exists). SECURITY: in production, the server refuses to
# start (process.exit(1)) if BOTH vars are still set once any admin
# already exists — remove both from your environment right after first
# login.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
